<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- ID del elemento -->
            <TextView
                android:id="@+id/tv_detail_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@android:color/secondary_text_dark"
                android:text="ID: 1"
                android:layout_marginBottom="8dp" />

            <!-- Título principal -->
            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="Título del elemento"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <!-- Descripción/contenido dinámico -->
            <TextView
                android:id="@+id/tv_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/secondary_text_dark"
                android:text="Descripción detallada del elemento seleccionado"
                android:textAlignment="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- Botón de acción interactivo -->
            <Button
                android:id="@+id/btn_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ejecutar Acción"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:background="@drawable/button_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:minWidth="120dp" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/darker_gray"
                android:alpha="0.5" />

            <!-- Instrucciones -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@android:color/tertiary_text_dark"
                android:text="Desliza hacia atrás para regresar\nToca el botón para ejecutar acciones"
                android:textAlignment="center"
                android:alpha="0.7" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>